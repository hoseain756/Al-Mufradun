<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>CFBundleDisplayName</key>
		<string>AlMufradun</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>adhkar_viewer</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<key>LSRequiresIPhoneOS</key>
		<true/>

		<!-- Launch screen: enables native full-screen rendering on all modern
		     iPhones (no letterboxing). Without this, iOS runs the app in
		     compatibility mode with black bars. Do NOT also declare the
		     empty UILaunchScreen dict key: having both keys is ambiguous
		     and some SDKs then fall back to compatibility letterboxing. -->
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>

		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationPortraitUpsideDown</string>
		</array>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<key>UIStatusBarHidden</key>
		<false/>

		<!-- Background modes for periodic prayer-schedule refresh. -->
		<key>UIBackgroundModes</key>
		<array>
			<string>fetch</string>
			<string>processing</string>
		</array>
		<!-- workmanager.background.task is the hardcoded BGTaskScheduler
		     identifier used by the workmanager iOS plugin; without it the
		     periodic refresh task is rejected by iOS at scheduling time. -->
		<key>BGTaskSchedulerPermittedIdentifiers</key>
		<array>
			<string>workmanager.background.task</string>
			<string>com.hussein.almufradun.prayer.refresh</string>
		</array>

		<!-- Location permission: needed for prayer times and Qibla calculation -->
		<key>NSLocationWhenInUseUsageDescription</key>
		<string>نحتاج إلى موقعك لحساب أوقات الصلاة واتجاه القبلة بدقة</string>
		<!-- Prompt text if the app ever needs temporary full accuracy. -->
		<key>NSLocationTemporaryUsageDescriptionDictionary</key>
		<dict>
			<key>PrayerAndQiblaAccuracy</key>
			<string>نحتاج إلى دقة الموقع الكاملة لحساب أوقات الصلاة واتجاه القبلة بدقة</string>
		</dict>

		<!-- URL schemes the app may pre-flight via url_launcher canLaunchUrl.
		     Fixes rate-app store link and external links failing on iOS. -->
		<key>LSApplicationQueriesSchemes</key>
		<array>
			<string>https</string>
			<string>itms-apps</string>
			<string>mailto</string>
			<string>tel</string>
		</array>

		<!-- No non-exempt encryption used; avoids export-compliance friction. -->
		<key>ITSAppUsesNonExemptEncryption</key>
		<false/>
	</dict>
</plist>
